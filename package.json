{
  "name": "hospate-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start:backend": "npm run start --workspace=apps/backend",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "start:mobile": "npm run start --workspace=apps/mobile",
    "start:tunnel": "npm run start --workspace=apps/mobile -- --tunnel",
    "start:lan": "npm run start --workspace=apps/mobile -- --lan -c",
    "build:apk": "npm --prefix apps/mobile run build:apk",
    "test:api": "node test-api.js",
    "build": "npm run build --workspaces",
    "seed": "npm run seed --workspace=apps/backend"
  },
  "keywords": [
    "hospate",
    "health-intelligence",
    "ai-health-buddy",
    "medical-ocr",
    "fhir"
  ],
  "author": "Hospate Engineering Team",
  "license": "MIT",
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "babel-preset-expo": "~54.0.12",
    "expo": "~54.0.37",
    "metro": "^0.83.1"
  }
}

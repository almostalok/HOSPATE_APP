# HOSPATE ENVIRONMENT CONFIGURATION
PORT=3000
NODE_ENV=development
JWT_SECRET=hospate_jwt_secret_demo_2026
JWT_REFRESH_SECRET=hospate_refresh_secret_demo_2026

# DATABASE (PostgreSQL / MongoDB / Redis for production container mode)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hospate_db
MONGODB_URI=mongodb://localhost:27017/hospate_docs
REDIS_URL=redis://localhost:6379

# AI & OCR CONFIGURATION
AI_PROVIDER=hospate_internal_context
OCR_ENGINE=tesseract_hybrid
AI_API_KEY=your_gemini_or_openai_api_key_optional

# STORAGE
STORAGE_DRIVER=local
STORAGE_DIR=./uploads
